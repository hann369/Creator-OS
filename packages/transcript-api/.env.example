# Optional: protect the endpoint with a shared secret
# TRANSCRIPT_API_SECRET=a-long-random-string

# Optional: Webshare rotating residential proxies (recommended for production)
# Sign up at https://www.webshare.io
# WEBSHARE_PROXY_USERNAME=your-username
# WEBSHARE_PROXY_PASSWORD=your-password

# Optional: custom proxy (alternative to Webshare)
# PROXY_HTTP_URL=http://user:pass@proxy.example.com:8080
# PROXY_HTTPS_URL=https://user:pass@proxy.example.com:8080
