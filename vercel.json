{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/ws/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|ws|assets|vite).*)",
      "destination": "/index.html"
    }
  ]
}
