{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "crons": [
    { "path": "/api/v1/telegram/briefing", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/ws/:path*", "destination": "/api" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
