# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Mistral (server-side reasoning + vision). Never expose to the browser.
MISTRAL_API_KEY=your-mistral-key

# Social-analytics ingest (optional). Without these the /api/v1/social/ingest
# endpoint returns 501 and the UI shows a "connect your account" hint.
YOUTUBE_API_KEY=your-google-api-key          # YouTube Data API v3
INSTAGRAM_ACCESS_TOKEN=your-meta-graph-token # Instagram Graph API

# Telegram bot (Creator OS has its OWN bot — separate token from the Life OS bot).
TELEGRAM_BOT_TOKEN=123456:your-bot-token          # from @BotFather
TELEGRAM_BOT_USERNAME=YourCreatorBot              # without the @ (used to build the deep link)
TELEGRAM_WEBHOOK_SECRET=a-long-random-string      # passed to setWebhook; Telegram echoes it back
TELEGRAM_CRON_SECRET=another-long-random-string   # protects the /telegram/briefing cron

# Ecosystem identity reuse (optional): if a user already connected Telegram in the
# Life OS (pronoia-next / Firebase), reuse their id by email instead of re-linking.
# Points at a pronoia-next endpoint that resolves email -> telegramId.
ECOSYSTEM_LOOKUP_URL=https://your-life-os.app/api/agent-webhook
ECOSYSTEM_LOOKUP_SECRET=the-shared-WEBHOOK_SECRET-of-pronoia-next
